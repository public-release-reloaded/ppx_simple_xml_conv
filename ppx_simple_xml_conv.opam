opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_simple_xml_conv"
bug-reports: "https://github.com/public-release-reloaded/ppx_simple_xml_conv/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_simple_xml_conv.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_simple_xml_conv/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_js_style" {>= "v0.18~" & < "v0.19~"}
  "ppxlib_jane" {>= "v0.18~" & < "v0.19~"}
  "simple_xml" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {> "0.38.0"}
  "xmlm" {>= "1.4.0"}
]
available: arch != "x86_32"
synopsis: "A ppx deriver for simple_xml."
description: "
Part of the Jane Street's PPX rewriters collection.

    This ppx allows you to parse ocaml types to and from
    Simple_xml.element, with namespace support.
  
"
